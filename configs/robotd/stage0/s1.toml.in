# Stage 0 robotd config s1 (our tuning).
# S1: stand slot = alpha_stand.onnx, limp_fall on (upstream design: limp while falling,
# pose back once still, then the standing network gets up).
# Template: the POLICY_DIR placeholder becomes models/policies on the Mac
# (scripts/sim/stage0/run_robotd.zsh) or the bundle's policies/ on the board
# (scripts/board/stage0/run_board_robotd.zsh). The ground_pick slot is for 0b; with no manifest
# beside the files robotd uses its defaults: a 4 s cycle, handed back at phase 0.7.
[control]
hz = 50

[policy]
enabled = true
mode = "walk"
walk = "@POLICY_DIR@/walk_17500.onnx"
stand = "@POLICY_DIR@/alpha_stand.onnx"
sitstand = "none"
ground_pick = "@POLICY_DIR@/alpha_ground_pick.onnx"
kick_left = "none"
kick_right = "none"
roulade = "none"

# Our tuning, as configs/robotd/mac_sim.toml.in: what walk_17500 was trained with (mjlab 1.3.0
# has no action low-pass). Applies to every network robotd runs, the stand slot included.
action_scale = 1.0
standing_action_scale = 1.0
standing_gain_ratio = 1.0
gain = 200
head_lowpass = 1.0
legs_lowpass = 1.0
voltage_adapt = false

[safety]
limp_fall = true

[audio]
enabled = false
