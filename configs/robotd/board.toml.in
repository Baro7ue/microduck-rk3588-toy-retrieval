# RK3588 robotd parameters (from work/g3-offline/microduck-board/robotd.toml, 2026-10-07; only paths changed).
# Template: scripts/board/run_board_robotd.zsh points the POLICY_DIR placeholders at the policies/ folder
# of the run's bundle on the board, and copies every policy named here from models/policies/ into it.
# RK3588 runtime configuration: same parameters as the Mac rehearsal; board-local model paths.
[control]
hz = 50

[policy]
enabled = true
mode = "walk"
walk = "@POLICY_DIR@/walk_17500.onnx"
stand = "@POLICY_DIR@/velstand.onnx"
sitstand = "none"
ground_pick = "none"
kick_left = "none"
kick_right = "none"
roulade = "none"

# Match the unfiltered action output used in the successful policy replay.
action_scale = 1.0
standing_action_scale = 1.0
standing_gain_ratio = 1.0
gain = 200
head_lowpass = 1.0
legs_lowpass = 1.0
voltage_adapt = false

[audio]
enabled = false
