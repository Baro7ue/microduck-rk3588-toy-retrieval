# Mac sim-twin robotd parameters (from work/runtime_robotd.toml, 2026-10-04; only paths changed).
# Template: scripts/sim/run_mac_robotd.zsh replaces @MD_ROOT@ with the repository path.
[control]
hz = 50

[policy]
enabled = true
mode = "walk"
walk = "@MD_ROOT@/models/policies/walk_17500.onnx"
stand = "@MD_ROOT@/models/policies/velstand.onnx"
sitstand = "none"
ground_pick = "none"
kick_left = "none"
kick_right = "none"
roulade = "none"

# Match the unfiltered action output used in the successful policy replay.
action_scale = 1.0
standing_action_scale = 1.0
standing_gain_ratio = 1.0
gain = 200
head_lowpass = 1.0
legs_lowpass = 1.0
voltage_adapt = false

[audio]
enabled = false
