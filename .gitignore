# OS and Python caches
.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Local-only folders: big or binary. Only README.md and MANIFEST.tsv (path, bytes, sha256) are tracked.
/evidence/*
!/evidence/README.md
!/evidence/MANIFEST.tsv
/offline/*
!/offline/README.md
!/offline/MANIFEST.tsv
/references/*
!/references/README.md
!/references/MANIFEST.tsv
/data/*
!/data/README.md
!/data/MANIFEST.tsv
/runs/*
!/runs/README.md

# C++ benchmark build folder (cpp/board_bench).
/cpp/board_bench/build/

# Models: small final ONNX/RKNN files are tracked; training checkpoints and .pt weights are not.
/models/checkpoints/
/models/**/*.pt
/models/policies/.cache/

# Archive: the ball-following prototype, local only since 2026-11-01 (in git up to tag stage4-results).
/archive/

# Reorganisation working files (the move log itself is tracked).
/docs/reorg/snapshot_*.tsv
/docs/reorg/move_plan.tsv
